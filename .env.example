# Environment Variables for Local Development
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Hugging Face Token (for model uploads/downloads)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comet ML API Key (for experiment tracking)
# Get yours at: https://www.comet.com/api/my/settings/
COMET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Weights & Biases API Key
# WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Email notifications (if implemented)
# EMAIL_USERNAME=your_email@example.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_TO=recipient@example.com
